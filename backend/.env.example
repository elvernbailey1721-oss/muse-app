# PaintScope Mobile backend — copy to .env and fill in. NEVER commit real values.
# Providers without credentials stay disabled (fail closed).

# Server
PORT=4000
APP_BASE_URL=http://localhost:4000
# Comma-separated FULL URLs allowed as post-login redirect targets. Entries are
# matched EXACTLY (byte-for-byte, including path and query) — origin-wide
# entries are NOT expanded. Example mobile deep link: paintscope://auth/done
# The OIDC/SAML callback URL itself is always <APP_BASE_URL>/auth/callback/:provider.
APP_REDIRECT_ALLOWLIST=http://localhost:4000/auth/done

# Database: SQLite file path for local dev. For Postgres later, set DATABASE_URL
# to a postgres:// URL AND install the pg driver (SQL is written Postgres-compatible).
DATABASE_URL=./dev.sqlite3

# Secrets (generate: openssl rand -hex 32)
JWT_SECRET=change-me-64-hex-chars-minimum-please
# 64 hex chars (32 bytes) used to encrypt provider config secrets at rest.
CONFIG_ENCRYPTION_KEY=change-me-64-hex-chars-for-aes-256-gcm

# --- Google (OIDC; discovery https://accounts.google.com/.well-known/openid-configuration,
# issuer https://accounts.google.com; id_token has email + email_verified) ---
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOW_EMAIL_LINK=false
# GOOGLE_SCOPES=openid email profile            # default shown
# GOOGLE_ISSUER=                                # override only for non-standard deployments
# GOOGLE_AUTHORIZATION_ENDPOINT= / GOOGLE_TOKEN_ENDPOINT= / GOOGLE_USERINFO_ENDPOINT= / GOOGLE_JWKS_URI=
# GOOGLE_SKIP_DISCOVERY=false                   # true + the four endpoints above = no discovery fetch
# GOOGLE_CLAIM_MAPPING={"email":"email","name":"name"}   # JSON: our field <- provider claim

# --- Microsoft Entra ID (OIDC; issuer https://login.microsoftonline.com/<tenant>/v2.0) ---
# TENANT_ID IS REQUIRED. The multi-tenant "common" endpoint publishes a templated
# issuer (https://login.microsoftonline.com/{tenantid}/v2.0) that cannot validate
# id_tokens, so the provider fails closed without an explicit tenant id.
MICROSOFT_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_ALLOW_EMAIL_LINK=false
# MICROSOFT_SCOPES=openid email profile
# MICROSOFT_CLAIM_MAPPING={"email":"email"}     # Entra often omits email_verified; linking
#                                               # should stay off unless you verified claims first

# --- Apple (no OIDC discovery doc; fixed endpoints https://appleid.apple.com/auth/*;
# issuer https://appleid.apple.com; client secret is a generated ES256 JWT) ---
APPLE_ENABLED=false
APPLE_CLIENT_ID=          # the Services ID (e.g. com.example.app.signin)
APPLE_TEAM_ID=            # 10-char Team ID — becomes the JWT iss
APPLE_KEY_ID=             # 10-char Key ID — becomes the JWT kid
# PEM-encoded ES256 private key (use \n for newlines if single-line). The server
# generates a short-lived client_secret JWT from this on demand (never stored).
APPLE_PRIVATE_KEY=
APPLE_ALLOW_EMAIL_LINK=false
# Apple sends name/email ONLY on first consent; later sign-ins carry sub+email
# in the id_token. Keep APPLE_ALLOW_EMAIL_LINK=false unless you understand this.

# --- GitHub (OAuth2 only: NO discovery, NO id_token; PKCE S256) ---
# Identity = numeric GitHub user id (stable). Verified email comes from
# GET /user/emails (primary+verified preferred); private-email accounts that
# expose no verified email get users.email = NULL.
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOW_EMAIL_LINK=false
# GITHUB_SCOPES=read:user user:email

# --- LinkedIn (OIDC; discovery https://www.linkedin.com/oauth/.well-known/openid-configuration,
# issuer https://www.linkedin.com; claims: sub, email, email_verified, profile) ---
LINKEDIN_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ALLOW_EMAIL_LINK=false

# --- Okta (OIDC; issuer https://<org>.okta.com or https://<org>.okta.com/oauth2/default;
# discovery is <issuer>/.well-known/openid-configuration) ---
OKTA_ENABLED=false
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_ALLOW_EMAIL_LINK=false

# --- Auth0 (OIDC; issuer https://<tenant>.<region>.auth0.com;
# discovery is <issuer>/.well-known/openid-configuration) ---
AUTH0_ENABLED=false
AUTH0_ISSUER=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ALLOW_EMAIL_LINK=false

# --- Generic OIDC (any spec-compliant issuer) ---
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOW_EMAIL_LINK=false
# OIDC_AUTHORIZATION_ENDPOINT= / OIDC_TOKEN_ENDPOINT= / OIDC_USERINFO_ENDPOINT= / OIDC_JWKS_URI=
# OIDC_SKIP_DISCOVERY=false
# OIDC_CLAIM_MAPPING={"email":"email","name":"name","avatarUrl":"picture"}

# --- SAML 2.0 (DB-configured per organization ONLY; no env provider) ---
# Configure via the admin API: PATCH /orgs/:orgId/providers with type "saml".
# Required: entryPoint (IdP SSO URL), idpCert (PEM, array enables rotation),
# spEntityId, nameIdClaim (stable subject attribute — REQUIRED when the IdP
# issues transient NameIDs). ACS URL is <APP_BASE_URL>/auth/callback/saml?org_id=<orgId>.
# SP metadata: GET /orgs/:orgId/saml/metadata

# --- Push (FCM HTTP v1 via firebase-admin). Provide ONE of these at deploy time. ---
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- DANGER: test-only flags. NEVER set these in production. ---
# OIDC_TEST_ALLOW_HTTP=1   # lets openid-client talk to plain-HTTP issuers; the
#                          # test harness sets this for its local mock IdP only.
